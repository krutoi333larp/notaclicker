<Window x:Class="notclicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:notclicker"
        mc:Ignorable="d"
        Title="baseclickier" Height="320" Width="380"
        ResizeMode="NoResize">

    <Grid Background="#292929">

        <!-- Кнопка выбора клавиши (Бинд) -->
        <Button x:Name="BindBtn"
                Content="click for select key" 
                Width="150" 
                Height="50" 
                Foreground="Black"
                Margin="0,0,0,80"
                Click="buttonbindclick">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#abcfb7" 
                            CornerRadius="15" 
                            BorderBrush="Transparent" 
                            BorderThickness="0">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Переключатели режимов: Удержание / Переключение -->
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Margin="0,10,0,0">

            <RadioButton x:Name="RadioHold" 
                         Content="Hold" 
                         IsChecked="True" 
                         Foreground="#abcfb7" 
                         FontFamily="Consolas" 
                         FontSize="14" 
                         Margin="0,0,20,0"
                         Checked="RadioButton_Checked"/>

            <RadioButton x:Name="RadioToggle" 
                         Content="Toggle" 
                         Foreground="#abcfb7" 
                         FontFamily="Consolas" 
                         FontSize="14" 
                         Checked="RadioButton_Checked"/>
        </StackPanel>

        <!-- Поле ввода задержки (ms) -->
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Margin="0,90,0,0">

            <TextBlock Text="delay:" 
                       Foreground="#abcfb7" 
                       FontFamily="Consolas" 
                       VerticalAlignment="Center" 
                       Margin="0,0,10,0" 
                       FontSize="13"/>

            <TextBox x:Name="InputDelay" 
                     Text="10" 
                     Width="50" 
                     Padding="3"
                     Background="#202020" 
                     Foreground="#abcfb7" 
                     BorderBrush="#abcfb7" 
                     BorderThickness="1"
                     FontFamily="Consolas" 
                     FontWeight="Bold"
                     FontSize="13" 
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     TextChanged="InputDelay_TextChanged">

                <TextBox.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <TextBlock Text="ms"
                       Foreground="#abcfb7" 
                       FontFamily="Consolas" 
                       VerticalAlignment="Center" 
                       Margin="10,0,0,0" 
                       FontSize="13"/>
        </StackPanel>

    </Grid>
</Window>
